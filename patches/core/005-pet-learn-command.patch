+// Alteroth: teach your current pet (or the pet you target) any spell - e.g. ".pet learn 133" gives it Fireball.
+// The pet casts it from its action bar (and automatically if autocast is on). Spells use the pet's own mana.
+bool ChatHandler::HandlePetLearnCommand(char* args)
+{
+    Player* player = m_session ? m_session->GetPlayer() : nullptr;
+    Pet* pet = getSelectedPet();
+    if (!pet && player)
+        pet = player->GetPet();
+    if (!pet)
+    {
+        SendSysMessage("You need an active pet (or target one).");
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    uint32 spellId = ExtractSpellIdFromLink(&args);
+    if (!spellId || !sSpellTemplate.LookupEntry<SpellEntry>(spellId))
+    {
+        PSendSysMessage(LANG_COMMAND_NOSPELLFOUND);
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    if (pet->HasSpell(spellId))
+    {
+        SendSysMessage("Your pet already knows that spell.");
+        return true;
+    }
+
+    pet->learnSpell(spellId);
+    pet->SavePetToDB(PET_SAVE_AS_CURRENT, player);
+    PSendSysMessage("Your pet learned spell %u.", spellId);
+    return true;
+}
+
+bool ChatHandler::HandlePetUnlearnCommand(char* args)
+{
+    Player* player = m_session ? m_session->GetPlayer() : nullptr;
+    Pet* pet = getSelectedPet();
+    if (!pet && player)
+        pet = player->GetPet();
+    if (!pet)
+    {
+        SendSysMessage("You need an active pet (or target one).");
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    uint32 spellId = ExtractSpellIdFromLink(&args);
+    if (!spellId || !pet->HasSpell(spellId))
+    {
+        SendSysMessage("Your pet doesn't know that spell.");
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    pet->unlearnSpell(spellId, false);
+    if (player)
+        player->PetSpellInitialize();
+    PSendSysMessage("Your pet forgot spell %u.", spellId);
+    return true;
+}

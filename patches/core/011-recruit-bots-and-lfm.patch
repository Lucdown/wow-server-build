+    enum AltRole { ALT_ROLE_ANY = 0, ALT_ROLE_TANK = 1, ALT_ROLE_HEAL = 2, ALT_ROLE_DPS = 4 };
+
+    struct AltOffer { ObjectGuid bot; int dungeon = -1; time_t expires = 0; };
+    std::map<uint32, AltOffer> altOffers;
+    std::map<uint32, uint32> altLfmTimers;

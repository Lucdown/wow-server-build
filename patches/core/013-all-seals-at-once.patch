+// Alteroth: casting one seal also puts up every other seal you know (highest rank), in the same global
+// cooldown. Each extra seal still costs its own mana; seals you can't afford are skipped.
+static void AlterothCastAllSeals(Player* player, uint32 castId)
+{
+    static bool enabled = sConfig.GetBoolDefault("Alteroth.SealsTogether", true);
+    if (!enabled)
+        return;
+    uint32 castFirst = sSpellMgr.GetFirstSpellInChain(castId);
+    std::map<uint32, uint32> best; // first rank -> highest known rank
+    for (auto const& itr : player->GetSpellMap())
+    {
+        if (itr.second.state == PLAYERSPELL_REMOVED || itr.second.disabled)
+            continue;
+        SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(itr.first);
+        if (!info || !IsSealSpell(info))
+            continue;
+        uint32 first = sSpellMgr.GetFirstSpellInChain(itr.first);
+        if (first == castFirst)
+            continue;
+        auto b = best.find(first);
+        if (b == best.end() || sSpellMgr.GetSpellRank(itr.first) > sSpellMgr.GetSpellRank(b->second))
+            best[first] = itr.first;
+    }
+    std::string skipped;
+    std::vector<uint32> tried;
+    tried.push_back(castId);
+    for (auto const& b : best)
+    {
+        SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(b.second);
+        if (!info)
+            continue;
+        uint32 cost = Spell::CalculatePowerCost(info, player);
+        if (info->powerType == POWER_MANA)
+        {
+            if (player->GetPower(POWER_MANA) < cost)
+            {
+                skipped += std::string(skipped.empty() ? "" : ", ") + info->SpellName[0];
+                continue;
+            }
+            player->ModifyPower(POWER_MANA, -int32(cost));
+        }
+        player->CastSpell(player, info, TRIGGERED_OLD_TRIGGERED);
+        tried.push_back(b.second);
+    }
+
+    // Tell the player what actually ended up active (Alteroth.SealsReport = 0 turns this off)
+    static bool report = sConfig.GetBoolDefault("Alteroth.SealsReport", true);
+    if (!report)
+        return;
+    std::string up, lost;
+    for (uint32 id : tried)
+    {
+        SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(id);
+        if (!info)
+            continue;
+        std::string& list = player->HasAura(id) ? up : lost;
+        list += std::string(list.empty() ? "" : ", ") + info->SpellName[0];
+    }
+    ChatHandler ch(player);
+    ch.PSendSysMessage("Seals up: %s", up.empty() ? "none" : up.c_str());
+    if (!lost.empty())
+        ch.PSendSysMessage("Seals that didn't stay on: %s", lost.c_str());
+    if (!skipped.empty())
+        ch.PSendSysMessage("Seals skipped (not enough mana): %s", skipped.c_str());
+}

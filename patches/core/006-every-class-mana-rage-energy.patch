+void Player::SendAltPowerUpdate(uint32 diff)
+{
+    // Alteroth: the 2.4.3 client can only show one power bar, so tell the AlterPower addon about all three
+    if (!isRealPlayer() || !GetSession())
+        return;
+
+    if (m_altPowerTimer > diff)
+    {
+        m_altPowerTimer -= diff;
+        return;
+    }
+    m_altPowerTimer = 400;
+
+    uint32 mana = GetPower(POWER_MANA), manaMax = GetMaxPower(POWER_MANA);
+    uint32 rage = GetPower(POWER_RAGE) / 10, rageMax = GetMaxPower(POWER_RAGE) / 10;
+    uint32 energy = GetPower(POWER_ENERGY), energyMax = GetMaxPower(POWER_ENERGY);
+    uint32 sig = mana * 2654435761u ^ manaMax * 40503u ^ rage * 97u ^ rageMax * 389u ^ energy * 7919u ^ energyMax;
+    if (sig == m_altPowerSig && ++m_altPowerIdle < 12)
+        return;
+    m_altPowerSig = sig;
+    m_altPowerIdle = 0;
+
+    char buf[96];
+    snprintf(buf, sizeof(buf), "ALTPWR\t%u;%u;%u;%u;%u;%u;%u", mana, manaMax, rage, rageMax, energy, energyMax, uint32(GetPowerType()));
+    WorldPacket data;
+    ChatHandler::BuildChatPacket(data, CHAT_MSG_WHISPER, buf, LANG_ADDON, CHAT_TAG_NONE, GetObjectGuid(), GetName());
+    GetSession()->SendPacket(data);
+}
